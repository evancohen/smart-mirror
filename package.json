{
  "name": "smart-mirror",
  "version": "0.0.32",
  "description": "The fairest of them all",
  "main": "main.js",
  "scripts": {
    "start": "DISPLAY=\"${DISPLAY:=:0}\" LIBGL_ALWAYS_SOFTWARE=1 electron --disable-gpu --disable-gpu-compositing --use-gl=swiftshader main.js ",
    "train-model": "electron scripts/train-model.js",
    "sonus": "node sonus.js",
    "motion": "sudo node motion.js",
    "enable-motion": "npm install johnny-five raspi-io",
    "update": "git pull && npm install",
    "test": "eslint . --ignore-path .gitignore",
    "test-fix": "eslint . --ignore-path .gitignore --fix",
    "postinstall": "bash scripts/fix-electron-macos",
    "preinstall": "bash scripts/installcblas"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evancohen/smart-mirror.git"
  },
  "keywords": [
    "Smart Mirror",
    "IoT",
    "Voice Control",
    "DIY"
  ],
  "author": "Evan Cohen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/evancohen/smart-mirror/issues"
  },
  "homepage": "https://github.com/evancohen/smart-mirror",
  "devDependencies": {
    "eslint": "^6.8.0"
  },
  "dependencies": {
    "@electron/rebuild": "^3.7.1",
    "@electron/remote": "^2.1.3",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@google-cloud/speech": "^4.2.0",
    "@grpc/grpc-js": "^1.14.5",
    "alphavantage": "^2.5.0",
    "angular": "1.8.3",
    "angular-animate": "1.8.3",
    "angular-dynamic-locale": "^0.1.38",
    "angular-i18n": "^1.8.2",
    "angular-moment": "^1.3.0",
    "angular-sanitize": "1.8.3",
    "angular-translate": "2.19.1",
    "angular-translate-loader-static-files": "2.19.1",
    "annyang": "3.0.0",
    "cheerio": "1.0.0-rc.12",
    "electron": "^31.7.7",
    "electron-json-storage": "^4.4.0",
    "express": "^5.2.1",
    "fitbit-oauth2": "0.0.1",
    "humanize-duration": "^3.35.0",
    "hyperion-client": "1.0.3",
    "ip": "^2.0.1",
    "jsonform": "git+https://github.com/sdetweil/jsonform.git",
    "moment": "^2.31.0",
    "mqtt": "^5.16.0",
    "pretty-ms": "^7.0.1",
    "recorder": "git+https://git@github.com/sdetweil/recorder.git",
    "rrule": "2.8.1",
    "rss-parser": "^3.12.0",
    "skycons": "git+https://github.com/darkskyapp/skycons.git",
    "socket.io": "^4.8.4",
    "sonus": "git+https://github.com/sdetweil/sonus.git",
    "spotify-web-api-node": "^5.0.0",
    "waitprocess": "git+https://github.com/sdetweil/waitprocess.git",
    "winston": "^3.19.0",
    "youtube-api": "^3.0.2"
  },
  "engines": {
    "node": "18.x || 20.x || 22.x"
  },
  "overrides": {
    "undici": "^5.28.4",
    "nan": "^2.23.0"
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "env": {
      "node": true,
      "es6": true,
      "browser": true
    },
    "rules": {
      "no-console": 0
    },
    "parserOptions": {
      "ecmaVersion": 2017
    },
    "globals": {
      "angular": false,
      "annyang": false,
      "moment": false,
      "config": false,
      "RRule": false
    }
  }
}
